{
  "name": "product-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc --noEmit && vite build",
    "start": "node server/start.js",
    "test": "node --test server/*.test.js",
    "preview": "vite preview --host 127.0.0.1 --port 4422",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  }
}
